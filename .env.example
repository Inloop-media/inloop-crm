# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never expose

# These emails become admins on their first sign-in (comma separated)
ADMIN_EMAILS=you@inloopmedia.com

# Google account picker shows only this Workspace domain
ALLOWED_DOMAIN=inloopmedia.com

# Shared secret the website uses to send form leads to /api/leads (any long random string)
CRM_INTAKE_SECRET=generate-a-long-random-string

# Google Calendar meetings — the same OAuth client you pasted into Supabase → Auth → Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Inloop guest added to every discovery call invite (e.g. the ops lead)
MEETING_GUEST_EMAIL=
# Slack incoming webhook — the brief is posted here when a proposal meeting is booked
SLACK_WEBHOOK_URL=
# The CRM's public URL — used for links in Slack messages
CRM_URL=https://crm.inloopmedia.com
# Shared with the Mac worker (inloop-crl/crl-bot/.env) — any long random string
WORKER_SECRET=

# Push notifications on phones / desktops (generate once: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://inloop-crm.vercel.app
